# Site bazli PHP-FPM baglantisi. Degiskenler: {{FPM_SOCK}}

try_files $uri =404;
fastcgi_split_path_info ^(.+\.php)(/.+)$;
include fastcgi_params;

fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
fastcgi_param PATH_INFO       $fastcgi_path_info;
fastcgi_param HTTPS           $https if_not_empty;

fastcgi_pass unix:{{FPM_SOCK}};
fastcgi_index index.php;

fastcgi_buffers 16 16k;
fastcgi_buffer_size 32k;
fastcgi_read_timeout 300s;
fastcgi_intercept_errors off;

# --- Sayfa onbellegi ---------------------------------------------------------
# $skip_cache 00-tuning.conf'taki map'lerden gelir (giris yapmis kullanici,
# sepet/odeme/hesabim, POST, sorgu dizesi -> onbellek atlanir).
# Set-Cookie donen yanitlar nginx tarafindan zaten onbelleklenmez; bu ikinci
# guvenlik katmanini bilerek koruyoruz (fastcgi_ignore_headers kullanilmiyor).
fastcgi_cache WPCACHE;
fastcgi_cache_valid 200 301 302 10m;
fastcgi_cache_valid 404 1m;
fastcgi_cache_bypass $skip_cache;
fastcgi_no_cache    $skip_cache;
fastcgi_cache_lock on;
fastcgi_cache_lock_timeout 10s;
fastcgi_cache_background_update on;
fastcgi_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
fastcgi_cache_revalidate on;

add_header X-FastCGI-Cache $upstream_cache_status always;
