# Multi-site vhost sablonu.
# Degiskenler: {{DOMAIN}} {{SERVER_NAMES}} {{SITE_SLUG}} {{ROOT}} {{FPM_SOCK}}
# Not: Bu dosya HTTP (80) uzerinden yayin yapar. Sertifika icin:
#   certbot --nginx -d {{SERVER_NAMES // bosluklar -d ile}}
# certbot 443 server blogunu ve http->https yonlendirmesini kendisi ekler.

server {
    listen 80;
    listen [::]:80;

    server_name {{SERVER_NAMES}};
    root {{ROOT}};

    access_log /var/log/nginx/{{SITE_SLUG}}.access.log;
    error_log  /var/log/nginx/{{SITE_SLUG}}.error.log;

    # Let's Encrypt dogrulamasi her zaman acik kalsin
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type "text/plain";
        allow all;
    }

    # Cloudflare proxy arkasinda gercek ziyaretci IP'si
    include snippets/cloudflare-realip.conf;

    # Font gzip: wordpress.conf'tan ONCE olmali — nginx regex location'lari
    # tanim sirasina gore dener ve wordpress.conf'un statik blogu
    # ttf|otf|eot uzantilarini da kapsar (CLAUDE.md 6n).
    include snippets/font-gzip.conf;

    include snippets/wordpress.conf;
    include snippets/security.conf;

    # Giris sayfasina hiz limiti
    location = /wp-login.php {
        limit_req zone=wplogin burst=5 nodelay;
        include snippets/fastcgi-php-{{SITE_SLUG}}.conf;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php-{{SITE_SLUG}}.conf;
    }
}
